{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main",
    "ide-repair",
    "proof-center"
  ],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "shell:allow-open",
    "dialog:default",
    "updater:default",
    "process:allow-restart",
    "allow-app-commands"
  ]
}
