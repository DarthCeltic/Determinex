{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Determinex",
  "version": "0.1.0",
  "identifier": "run.determinex.desktop",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Determinex - Proof-Governed Code Workbench",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: asset: https://asset.localhost; connect-src 'self' http://localhost:* http://127.0.0.1:*; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: tauri: https://asset.localhost; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../../determinex_model_registry.json",
      "../../Modelfile.sentinel",
      "../../Modelfile.engineer",
      "../../Modelfile.observer",
      "../../Modelfile.leviathan"
    ],
    "externalBin": [
      "bin/determinex-hive"
    ],
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      }
    },
    "shortDescription": "Proof-governed local-first AI coding workbench",
    "longDescription": "Determinex is a local-first, proof-governed AI coding workbench with compiler and verifier loops, evidence dashboards, and separately gated cloud, training, source-mutation, and release workflows. Current product truth is evidence-bound; broad release readiness and universal support are not implied.",
    "copyright": "(c) 2026 Determinex Contributors",
    "category": "DeveloperTool",
    "publisher": "Determinex Contributors"
  }
}
